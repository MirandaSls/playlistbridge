# Public URLs used by browser redirects and backend CORS.
BACKEND_PUBLIC_URL=http://localhost:8080
FRONTEND_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js exposes this value to browser code at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Spring profile selected by docker-compose.
SPRING_PROFILES_ACTIVE=prod

# Spotify Developer Dashboard application credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/login/oauth2/code/spotify

# Google Cloud OAuth client credentials (YouTube Data API access).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
